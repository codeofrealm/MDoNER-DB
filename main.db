-- ============================================
-- USEFUL QUERIES
-- ============================================

-- Current high/critical risk locations
SELECT
    l.location_name,
    l.state,
    l.district,
    r.risk_score,
    r.risk_level,
    r.probability,
    r.prediction_time
FROM risk_predictions r
JOIN monitoring_locations l
    ON r.location_id = l.location_id
WHERE r.risk_level IN ('HIGH', 'CRITICAL')
ORDER BY r.risk_score DESC;


-- Latest environmental readings
SELECT
    l.location_name,
    l.state,
    e.rainfall_24h_mm,
    e.rainfall_72h_mm,
    e.soil_moisture_percent,
    e.recorded_at
FROM environmental_readings e
JOIN monitoring_locations l
    ON e.location_id = l.location_id
ORDER BY e.recorded_at DESC;


-- Active critical alerts
SELECT
    a.alert_id,
    l.location_name,
    l.state,
    a.alert_level,
    a.alert_message,
    a.issued_at
FROM alerts a
JOIN monitoring_locations l
    ON a.location_id = l.location_id
WHERE a.status = 'ACTIVE'
  AND a.alert_level = 'CRITICAL'
ORDER BY a.issued_at DESC;
