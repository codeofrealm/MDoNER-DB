-- ============================================
-- MDoNER - Landslide Risk Monitoring System
-- PostgreSQL Sample Database
-- ============================================

CREATE DATABASE landslide_monitoring;

-- Connect to the database:
-- \c landslide_monitoring


-- 1. Monitoring locations
CREATE TABLE monitoring_locations (
    location_id SERIAL PRIMARY KEY,
    location_name VARCHAR(150) NOT NULL,
    state VARCHAR(100) NOT NULL,
    district VARCHAR(100),
    latitude DECIMAL(10, 7) NOT NULL,
    longitude DECIMAL(10, 7) NOT NULL,
    elevation_m DECIMAL(8, 2),
    slope_angle DECIMAL(5, 2),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- 2. Sensors installed at locations
CREATE TABLE sensors (
    sensor_id SERIAL PRIMARY KEY,
    location_id INT NOT NULL REFERENCES monitoring_locations(location_id),
    sensor_type VARCHAR(50) NOT NULL,
    sensor_code VARCHAR(50) UNIQUE NOT NULL,
    installation_date DATE,
    status VARCHAR(20) DEFAULT 'ACTIVE',
    last_maintenance_date DATE
);


-- 3. Weather/environment observations
CREATE TABLE environmental_readings (
    reading_id BIGSERIAL PRIMARY KEY,
    location_id INT NOT NULL REFERENCES monitoring_locations(location_id),
    recorded_at TIMESTAMP NOT NULL,
    rainfall_mm DECIMAL(8, 2) DEFAULT 0,
    rainfall_24h_mm DECIMAL(8, 2),
    rainfall_72h_mm DECIMAL(8, 2),
    temperature_c DECIMAL(5, 2),
    humidity_percent DECIMAL(5, 2),
    soil_moisture_percent DECIMAL(5, 2),
    groundwater_level_m DECIMAL(8, 2)
);


-- 4. Historical landslide events
CREATE TABLE landslide_events (
    event_id SERIAL PRIMARY KEY,
    location_id INT NOT NULL REFERENCES monitoring_locations(location_id),
    event_date TIMESTAMP NOT NULL,
    severity VARCHAR(20),
    estimated_volume_m3 DECIMAL(12, 2),
    casualties INT DEFAULT 0,
    road_blocked BOOLEAN DEFAULT FALSE,
    description TEXT
);


-- 5. AI/ML risk predictions
CREATE TABLE risk_predictions (
    prediction_id BIGSERIAL PRIMARY KEY,
    location_id INT NOT NULL REFERENCES monitoring_locations(location_id),
    prediction_time TIMESTAMP NOT NULL,
    risk_score DECIMAL(5, 2) CHECK (risk_score >= 0 AND risk_score <= 100),
    risk_level VARCHAR(20) NOT NULL,
    probability DECIMAL(5, 4),
    model_version VARCHAR(50),
    contributing_factors JSONB,
    recommended_action TEXT
);


-- 6. Early warning alerts
CREATE TABLE alerts (
    alert_id BIGSERIAL PRIMARY KEY,
    location_id INT NOT NULL REFERENCES monitoring_locations(location_id),
    prediction_id BIGINT REFERENCES risk_predictions(prediction_id),
    alert_level VARCHAR(20) NOT NULL,
    alert_message TEXT NOT NULL,
    issued_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    acknowledged_at TIMESTAMP,
    acknowledged_by VARCHAR(100),
    status VARCHAR(20) DEFAULT 'ACTIVE'
);


-- 7. Users / officials
CREATE TABLE system_users (
    user_id SERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    phone VARCHAR(20),
    role VARCHAR(50) NOT NULL,
    department VARCHAR(150),
    state VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


